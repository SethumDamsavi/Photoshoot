# Admin sign-in for Studio Admin (/admin).
#
# Live site: add these in Vercel → your project → Settings → Environment Variables,
# then redeploy (Deployments → ⋯ → Redeploy) so they take effect.
# On this computer: copy this file to .env.local and fill it in (git ignores .env.local).
#
# Never put real values in this file or anywhere else in the repository: it is public.

# The name you type in the Username box
ADMIN_USERNAME=

# At least 10 characters; a long passphrase is best. Without it, nobody can sign in.
ADMIN_PASSWORD=

# Optional: a long random string used to sign sessions. If it is empty, the site uses its
# storage token instead. Changing it (or the password) signs everyone out.
ADMIN_TOKEN_SECRET=
