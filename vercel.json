{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/[...all].js"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "includeFiles": "data/**"
    }
  }
}
